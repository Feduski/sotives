# ─── Monad Testnet ────────────────────────────────────────────────────────────
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Wallet del BACKEND (árbitro/validador) — NO es la wallet del usuario.
# Solo necesita un poco de MON para pagar gas en resolveCommitment.
# Generarla: cast wallet new
# Fondearla: https://faucet.monad.xyz
VALIDATOR_PRIVATE_KEY=0x...

# ─── Contratos ────────────────────────────────────────────────────────────────
COMMITMENT_MANAGER_ADDRESS=0x...
COMMITMENT_POOL_ADDRESS=0x...
MULTISIG_FACTORY_ADDRESS=0x...

# ─── IA ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── APIs externas ────────────────────────────────────────────────────────────
# GitHub: opcional. Sin token = 60 req/hora (suficiente para hackathon).
# Con token = 5000 req/hora. Generarlo en github.com/settings/tokens
GITHUB_TOKEN=

# Twitter/X: obligatorio para leer tweets públicos (API v2 no tiene acceso sin auth).
# Conseguirlo en developer.twitter.com → Bearer Token
TWITTER_BEARER_TOKEN=
